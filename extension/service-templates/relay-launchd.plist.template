<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- un-bien relay. Generated by `unbien install relay`. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.unbien.relay</string>

  <key>ProgramArguments</key>
  <array>
    <string>{RELAY_BIN}</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>{LOG}</string>
  <key>StandardErrorPath</key>
  <string>{LOG}</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>UNBIEN_RELAY_PORT</key>
    <string>{PORT}</string>
    <key>HOME</key>
    <string>{HOME}</string>
  </dict>
</dict>
</plist>
