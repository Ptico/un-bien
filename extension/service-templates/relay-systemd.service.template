[Unit]
Description=un-bien relay
Documentation=https://docs.georgeharker.com/un-bien
After=default.target

[Service]
Type=simple
ExecStart={RELAY_BIN}
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
Environment="UNBIEN_RELAY_PORT={PORT}"
Environment="HOME={HOME}"
Environment="PI_CODING_AGENT_DIR={PI_AGENT_DIR}"
{UNBIEN_ENV_SYSTEMD}

[Install]
WantedBy=default.target
